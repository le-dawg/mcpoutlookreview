# --- Required (dev + prod) ---------------------------------------------------

AZURE_TENANT_ID=9de3d9c3-b0bb-4d2e-93ab-f6407a8b3793
AZURE_CLIENT_ID=4c797321-edf4-4382-b455-4501cd87c8c0
CERT_THUMBPRINT=00EFA562B712661D3DA092803C99014C83A60B70
DEV_USER_UPN=jacob@ai-raadgivning.dk

# Certificate auth — set ONE of these:
#   - CERT_PRIVATE_KEY_PATH: file path (dev — reads from scripts/generate-cert.sh output)
#   - CERT_PRIVATE_KEY_PEM:  full PEM content as a single env-var value (prod — populated from Key Vault)
CERT_PRIVATE_KEY_PATH=../out/cert/claude-outlook-mcp.key
# CERT_PRIVATE_KEY_PEM=

# --- OAuth callback ---------------------------------------------------------

# Dev: http://localhost:8787/auth/callback  (must also be registered on the Entra app reg)
# Prod: https://outlook.mcp.ai-raadgivning.dk/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8787/auth/callback

# --- HTTP server ------------------------------------------------------------

PORT=8787

# --- Token cache backend ----------------------------------------------------

# Dev: leave KV_NAME empty → uses local file at TOKEN_STORE_PATH
# Prod: set KV_NAME to your Key Vault name → uses KV-backed MSAL cache plugin
# KV_NAME=
TOKEN_STORE_PATH=./.local/tokens.json

# --- Bearer auth on /mcp ----------------------------------------------------

# Dev: leave empty (anyone on localhost can call /mcp)
# Prod: set to a random secret (`openssl rand -hex 32`) — clients must send `Authorization: Bearer <token>`
# MCP_AUTH_TOKEN=
